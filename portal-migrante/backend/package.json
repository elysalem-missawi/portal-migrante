{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:compiled",
    "test:compiled": "node --test dist/tests",
    "seed:municipalities": "ts-node src/seedMunicipalities.ts",
    "seed:service-categories": "ts-node src/seedServiceCategories.ts",
    "seed:publication-categories": "ts-node src/seedPublicationCategories.ts",
    "migrate:database": "ts-node src/migrations/migrateDatabaseRedesign.ts",
    "migrate:database:apply": "ts-node src/migrations/migrateDatabaseRedesign.ts --apply",
    "seed:municipal-demo": "ts-node src/seedMunicipalDemo.ts",
    "start:municipal-demo": "node dist/seedMunicipalDemo.js && node dist/index.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.1",
    "portal-migrante": "file:..",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.37",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
